# Copy this file to backend/.env (or to .env in the repo root) and fill it in.
# The real .env is gitignored. The key stays on the backend and is never sent to the browser.

PORT=3001

# Which AI explains the engine's analysis when the app doesn't say: "openai" or "anthropic" (Claude).
# You can set up one or both. In the app, the "Explained by" switch on the Coach / Overview tab picks per request.
AI_PROVIDER=openai

# Your OpenAI API key (https://platform.openai.com/api-keys).
OPENAI_API_KEY=

# A current OpenAI chat model that supports structured outputs (JSON schema), e.g. one of the gpt-4o / gpt-4.1 / gpt-5 families.
OPENAI_MODEL=

# Optional: only set this to use an OpenAI-compatible server instead of api.openai.com.
# OPENAI_BASE_URL=

# Your Anthropic API key (https://console.anthropic.com/settings/keys) to use Claude.
ANTHROPIC_API_KEY=

# A Claude model that supports structured outputs; claude-haiku-5-5 is the cheapest current one,
# claude-sonnet-5-5 and claude-opus-5-5 are stronger.
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: only set this to use a different Anthropic-compatible endpoint.
# ANTHROPIC_BASE_URL=
