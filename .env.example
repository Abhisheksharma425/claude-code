# Copy this file to backend/.env (or to .env in the repo root) and fill it in.
# The real .env is gitignored. The key stays on the backend and is never sent to the browser.

PORT=3001

# Which AI provider explains the engine's analysis (only "openai" for now).
AI_PROVIDER=openai

# Your OpenAI API key (https://platform.openai.com/api-keys).
OPENAI_API_KEY=

# A current OpenAI chat model that supports structured outputs (JSON schema), e.g. one of the gpt-4o / gpt-4.1 / gpt-5 families.
OPENAI_MODEL=

# Optional: only set this to use an OpenAI-compatible server instead of api.openai.com.
# OPENAI_BASE_URL=
